# Sandbox Ship, English.
# Each msgid is the French text as the code writes it; {0}, {1}... stand for the values a
# composed text takes (numbers, names): the game finds them in the French text it shows and
# puts them in the English one (scripts/Core/Lang.cs). Keep the holes, in any order.
# Kept up to date with godot/tools/lang.py (--check lists what is missing, --add adds it).
msgid ""
msgstr ""
"Language: en\n"
"Content-Type: text/plain; charset=UTF-8\n"

# Texts the code makes at run time out of words of its own, found by godot/tools/lang-check.sh
# rather than in the code: forms of the code's words, and templates too plain for lang.py.

